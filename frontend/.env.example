# Frontend settings. None of these are secrets, and there must never be an API key here.

# Where the backend is, as seen from the machine that RUNS the frontend server. The browser never uses this;
# it calls /api on the same website and Next.js forwards it. Read at build time.
BACKEND_URL=http://localhost:8000

# Optional: only set this to bypass the /api proxy (for example, a test pointing at another origin).
# NEXT_PUBLIC_API_BASE=http://localhost:3000/api

# Optional: set to true to make the Content-Security-Policy report-only instead of enforced. Read at build time.
# CSP_REPORT_ONLY=false
