# For running the backend directly on your computer (without Docker).   Copy to backend\.env
# Never commit the real .env.

DATABASE_URL=postgresql+psycopg://acis:enter_your_database_password_here@localhost:5432/acis
SECRET_KEY=enter_a_long_random_string_here
ENVIRONMENT=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

AUTH_MODE=local
SUPABASE_JWT_SECRET=

LLM_PROVIDER=none
LLM_API_KEY=enter_your_api_key_here
LLM_BASE_URL=
LLM_MODEL=
STT_PROVIDER=none
STT_API_KEY=enter_your_api_key_here
STT_BASE_URL=
STT_MODEL=whisper-1
RESEARCHER_EMAILS=
