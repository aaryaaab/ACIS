# ACIS settings for Docker Compose.   Copy this file to ".env" in the same folder:   copy .env.example .env
# Never commit the real .env. It is listed in .gitignore.

# ======================= REQUIRED: you must change these two =======================
# Database password. Use letters and digits only (symbols can break the database address).
#   Make one:  python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
POSTGRES_PASSWORD=enter_a_database_password_here

# Signs login sessions. At least 32 random characters.
#   Make one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=enter_a_long_random_string_here

# ======================= Deployment (change when you put ACIS on a real server) =======================
# "development" runs with relaxed checks. "production" refuses to start with a weak SECRET_KEY, COOKIE_SECURE=false or CORS_ORIGINS=*
ENVIRONMENT=development
# true when the site is served over HTTPS (required in production). Leave false for http://localhost.
COOKIE_SECURE=false
# The exact address people type in the browser. Logins from any other site are refused.
# Several are allowed, separated by commas.
CORS_ORIGINS=http://localhost:3000

# ======================= Optional ports and database names =======================
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
# DB_PORT=5432
# POSTGRES_USER=acis
# POSTGRES_DB=acis
# SEED_ON_START=true
# CSP_REPORT_ONLY=false

# ======================= Optional: everything below works without any of it =======================
# Mentor language model. none | ollama (free, runs on your computer) | openai_compatible
LLM_PROVIDER=none
LLM_API_KEY=enter_your_api_key_here
LLM_BASE_URL=
LLM_MODEL=

# Voice journal speech-to-text (any OpenAI-compatible /audio/transcriptions service). none = typed or browser dictation only.
STT_PROVIDER=none
STT_API_KEY=enter_your_api_key_here
STT_BASE_URL=
STT_MODEL=whisper-1

# Emails (comma separated) allowed to download the anonymised research export.
RESEARCHER_EMAILS=

# Login provider. "local" is built in. "supabase" is NOT fully supported yet (see README).
AUTH_MODE=local
SUPABASE_JWT_SECRET=
